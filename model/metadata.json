{
  "dataset_name": "WHO Life Expectancy",
  "dataset_description": "World Health Organization / UN life expectancy and health indicators, covering roughly 193 countries from 2000 to 2015.\n",
  "config_path": "config\\who_life_expectancy.yaml",
  "target_col": "Life_Expectancy",
  "predictor_cols": [
    "Adult_Mortality",
    "HIV_AIDS",
    "Under-Five_Deaths",
    "Polio",
    "Diphtheria",
    "Hepatitis_B",
    "Thinness_10-19_Years",
    "Alcohol",
    "Pct_Expenditure",
    "Ttl_Expend",
    "Income_Comp_Of_Resources",
    "Schooling",
    "Measles"
  ],
  "predictors": [
    {
      "column": "Adult_Mortality",
      "label": "Adult Mortality (per 1,000 adults)",
      "description": "Probability of dying between ages 15-60, per 1,000 population. Higher = worse.",
      "input_type": "slider",
      "show_in_ui": true
    },
    {
      "column": "HIV_AIDS",
      "label": "HIV/AIDS deaths (per 1,000, ages 0-4)",
      "description": "Deaths per 1,000 live births caused by HIV/AIDS, ages 0-4.",
      "input_type": "slider",
      "show_in_ui": true
    },
    {
      "column": "Under-Five_Deaths",
      "label": "Under-Five Deaths (per 1,000)",
      "description": "Deaths per 1,000 population among children under age 5.",
      "input_type": "slider",
      "show_in_ui": true
    },
    {
      "column": "Polio",
      "label": "Polio immunization (%)",
      "description": "% of 1-year-olds immunized against polio.",
      "input_type": "slider",
      "show_in_ui": true
    },
    {
      "column": "Diphtheria",
      "label": "Diphtheria (DTP3) immunization (%)",
      "description": "% of 1-year-olds immunized against diphtheria (DTP3 vaccine).",
      "input_type": "slider",
      "show_in_ui": true
    },
    {
      "column": "Hepatitis_B",
      "label": "Hepatitis B immunization (%)",
      "description": "% of 1-year-olds immunized against Hepatitis B.",
      "input_type": "slider",
      "show_in_ui": true
    },
    {
      "column": "Thinness_10-19_Years",
      "label": "Thinness, ages 10-19 (%)",
      "description": "% of 10-19 year-olds classified as underweight (thin) for their age.",
      "input_type": "slider",
      "show_in_ui": true
    },
    {
      "column": "Alcohol",
      "label": "Alcohol consumption (litres/capita)",
      "description": "Liters of pure alcohol consumed per capita (age 15+ population).",
      "input_type": "number",
      "show_in_ui": true
    },
    {
      "column": "Pct_Expenditure",
      "label": "Health expenditure (% of GDP per capita)",
      "description": "Health expenditure as a percentage of GDP per capita.",
      "input_type": "number",
      "show_in_ui": true
    },
    {
      "column": "Ttl_Expend",
      "label": "Total govt. health expenditure (% of total govt. expenditure)",
      "description": "Total government health spending as a percentage of total government spending.",
      "input_type": "number",
      "show_in_ui": true
    },
    {
      "column": "Income_Comp_Of_Resources",
      "label": "Income Composition of Resources (0-1 index)",
      "description": "A UN Human Development Index sub-component (0-1 scale) capturing how effectively a country converts income into human development outcomes. Higher = more effective.\n",
      "input_type": "number",
      "show_in_ui": true
    },
    {
      "column": "Schooling",
      "label": "Schooling (avg. years)",
      "description": "Average number of years of schooling completed.",
      "input_type": "number",
      "show_in_ui": true
    },
    {
      "column": "Measles",
      "label": "Measles cases (reported per 1,000)",
      "description": "Number of reported measles cases per 1,000 population.",
      "input_type": "number",
      "show_in_ui": false
    }
  ],
  "test_r2": 0.9618219047610357,
